<odoo>
    <record id="view_effect_remittance_form_sepa" model="ir.ui.view">
        <field name="name">account.effect.remittance.form.sepa</field>
        <field name="model">account.effect.remittance</field>
        <field name="inherit_id" ref="l10n_es_effects.view_effect_remittance_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_sepa" type="object" string="Generar SEPA" class="btn-primary" invisible="state in ('cancelled','paid')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="SEPA">
                    <group>
                        <field name="sepa_creditor_identifier"/>
                        <field name="sepa_message_id"/>
                        <field name="sepa_generated" readonly="1"/>
                        <field name="sepa_filename" readonly="1"/>
                        <field name="sepa_file" filename="sepa_filename" readonly="1" widget="binary"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
