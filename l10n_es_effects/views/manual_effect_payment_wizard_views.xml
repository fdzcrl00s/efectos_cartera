<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_effect_manual_payment_wizard" model="ir.ui.view">
        <field name="name">account.effect.manual.payment.wizard.form</field>
        <field name="model">account.effect.manual.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Saldar efecto">
                <sheet>
                    <group>
                        <field name="effect_id"/>
                        <field name="partner_id" string="Cliente / proveedor"/>
                        <field name="manual_account_id" invisible="not manual_account_id"/>
                        <field name="company_id" invisible="1"/>
                        <field name="company_type" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount_pending" readonly="1"/>
                        <field name="amount" string="Importe a saldar"/>
                    </group>
                    <group string="Datos de pago">
                        <field name="payment_date"/>
                        <field name="journal_id"/>
                        <field name="available_payment_document_ids" invisible="1"/>
                        <field name="payment_document_id"
                               string="Documento de pago"
                               domain="[('id', 'in', available_payment_document_ids)]"
                               required="1"/>
                        <field name="communication" string="Circular / Concepto"/>
                    </group>
                    <group string="Liquidación del efecto">
                        <field name="effect_balance"/>
                        <field name="effect_expenses"/>
                        <field name="expense_account_id" invisible="not effect_expenses"/>
                        <field name="effect_commissions"/>
                        <field name="commission_account_id" invisible="not effect_commissions"/>
                        <field name="group_bank_entries"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_payment" type="object" string="Crear pago" class="btn-primary"/>
                    <button string="Descartar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
