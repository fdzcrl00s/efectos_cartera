<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_effect_manual_payment_wizard" model="ir.ui.view">
        <field name="name">account.effect.manual.payment.wizard.form</field>
        <field name="model">account.effect.manual.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Saldar efecto">
                <sheet>
                    <group>
                        <field name="effect_id"/>
                        <field name="partner_id" string="Empresa"/>
                        <field name="manual_account_id"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount_pending" readonly="1"/>
                        <field name="amount"/>
                    </group>
                    <group>
                        <field name="payment_date"/>
                        <field name="journal_id"/>
                        <field name="available_payment_document_ids" invisible="1"/>
                        <field name="payment_document_id" domain="[('id', 'in', available_payment_document_ids)]" required="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_payment" type="object" string="Registrar pago" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
