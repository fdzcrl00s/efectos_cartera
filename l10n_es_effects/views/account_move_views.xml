<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_effects" model="ir.ui.view">
        <field name="name">account.move.form.effects</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_effects"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    invisible="not is_invoice(include_receipts=True)"
                >
                    <field name="effect_count" widget="statinfo" string="Efectos"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
