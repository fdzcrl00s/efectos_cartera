<odoo>
    <record id="view_move_form_effects" model="ir.ui.view">
        <field name="name">account.move.form.effects</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_effects" type="object" class="oe_stat_button" icon="fa-list-ol" invisible="effect_count == 0">
                    <field name="effect_count" widget="statinfo" string="Efectos"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_generate_effects" type="object" string="Generar efectos" class="btn-secondary" invisible="state != 'posted' or move_type not in ('out_invoice','out_refund','in_invoice','in_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
