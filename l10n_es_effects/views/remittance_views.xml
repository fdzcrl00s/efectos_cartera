<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_effect_remittance_list" model="ir.ui.view">
        <field name="name">account.effect.remittance.list</field>
        <field name="model">account.effect.remittance</field>
        <field name="arch" type="xml">
            <list string="Remesas" delete="true" default_order="date desc, id desc" decoration-danger="state in ('draft', 'partial')" decoration-info="state == 'paid'">
                <button name="action_open_effect" type="object" string="Nº Cartera" class="oe_link"/>
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id" string="Cliente"/>
                <field name="effect_count"/>
                <field name="amount_total"/>
                <field name="amount_paid"/>
                <field name="amount_pending"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state"/>
                <field name="paid_date"/>
            </list>
        </field>
    </record>
    <record id="view_account_effect_remittance_form" model="ir.ui.view">
        <field name="name">account.effect.remittance.form</field>
        <field name="model">account.effect.remittance</field>
        <field name="arch" type="xml">
            <form string="Remesa">
                <field name="has_active_payments" invisible="1"/>
                <field name="has_returnable_effects" invisible="1"/>
                <field name="has_valid_initial_move" invisible="1"/>
                <header>
                    <button name="action_saldar_entero" type="object" string="Saldar (entero)"
                            class="btn-primary" invisible="state != 'draft' or effect_count == 0 or amount_pending == 0 or not has_valid_initial_move"/>
                    <button name="action_saldar_parcial" type="object" string="Saldar parcialmente"
                            invisible="state in ('paid', 'cancelled') or effect_count == 0 or amount_pending == 0 or not has_valid_initial_move"/>
                    <button name="action_anular_saldado" type="object" string="Anular saldado"
                            invisible="not has_active_payments"/>
                    <button name="action_devolver_efectos" type="object" string="Devolver efectos"
                            invisible="not has_returnable_effects"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,partial,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_accounting_entries" type="object" class="oe_stat_button" icon="fa-book">
                            <span class="o_stat_text">Asientos</span>
                        </button>
                    </div>
                    <h1><span>Remesa nº </span><field name="cartera_number" readonly="1" nolabel="1"/></h1>
                    <group>
                        <group>
                            <field name="cartera_number" string="Nº Cartera" readonly="1"/>
                            <field name="company_type" invisible="1"/>
                            <field name="company_id"/>
                            <field name="bank_journal_id" readonly="state != 'draft'"/>
                            <field name="initial_move_id" string="Asiento inicial" readonly="1"/>
                            <field name="partner_bank_id" readonly="state != 'draft'"/>
                            <field name="amount_total"/>
                            <field name="amount_paid"/>
                            <field name="amount_pending"/>
                        </group>
                        <group>
                            <field name="due_date" readonly="state != 'draft'"/>
                            <field name="reference" string="Circular / Concepto" readonly="state != 'draft'"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Efectos agrupados">
                            <field name="effect_ids">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="due_date"/>
                                    <field name="display_label" string="Nombre"/>
                                    <field name="partner_id"/>
                                    <field name="amount"/>
                                    <field name="amount_pending"/>
                                    <field name="display_payment_state"/>
                                    <button name="action_ungroup_selected" type="object" string="Quitar" class="btn-link" invisible="parent.state in ('paid', 'cancelled') or parent.has_active_payments or state == 'paid'"/>
                                </list>
                            </field>
                            <div class="o_row mt-2">
                                <button name="action_add_pending_effects" type="object" string="Añadir efectos" class="btn-primary" invisible="state != 'draft' or has_active_payments"/>
                                <button name="action_ungroup_selected" type="object" string="Desagrupación Masiva" invisible="state in ('paid', 'cancelled') or has_active_payments"/>
                                <button name="action_update_changes" type="object" string="Actualizar cambios"/>
                            </div>
                        </page>
                        <page string="Efectos de la misma Cartera">
                            <field name="portfolio_effect_ids">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="reference" string="Referencia"/>
                                    <field name="due_date" string="Fecha"/>
                                    <field name="amount"/>
                                    <field name="amount_pending"/>
                                    <field name="display_payment_state"/>
                                    <field name="has_container_payments" invisible="1"/>
                                    <field name="is_portfolio_effect" invisible="1"/>
                                    <button name="action_anular_saldado" type="object" string="Anular saldado" class="btn-link"
                                            invisible="state != 'paid' or not has_container_payments"/>
                                    <button name="action_devolver" type="object" string="Devolver" class="btn-link"
                                            invisible="state != 'paid' or not is_portfolio_effect"/>
                                </list>
                            </field>
                        </page>
                        <page string="Histórico Pagos">
                            <field name="payment_history_ids">
                                <list create="false" delete="false">
                                    <field name="id"/>
                                    <field name="reference" readonly="1"/>
                                    <field name="move_id" string="Asiento"/>
                                    <field name="date" readonly="1"/>
                                    <field name="effect_ids" string="Agrupar Efectos"/>
                                    <field name="amount" string="Total"/>
                                    <field name="type" string="Tipo"/>
                                    <button name="action_anular_saldado" type="object" string="Anular saldado" class="btn-link"
                                            invisible="type != 'paid' or not move_id or move_id.state != 'posted'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Histórico Situaciones">
                            <field name="effect_ids">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="situation_state" string="Situación"/>
                                    <field name="paid_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_account_effect_remittance" model="ir.actions.act_window">
        <field name="name">Remesas</field>
        <field name="res_model">account.effect.remittance</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_effect_remittance_list"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('l10n_es_effects.view_account_effect_remittance_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('l10n_es_effects.view_account_effect_remittance_form')})]"/>
    </record>
</odoo>