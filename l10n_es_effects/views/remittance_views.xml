<odoo>
    <record id="view_effect_remittance_list" model="ir.ui.view">
        <field name="name">account.effect.remittance.list</field>
        <field name="model">account.effect.remittance</field>
        <field name="arch" type="xml">
            <list string="Remesas">
                <field name="name"/><field name="date"/><field name="due_date"/><field name="effect_count"/><field name="amount_total" sum="Total"/><field name="journal_id"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_effect_remittance_form" model="ir.ui.view">
        <field name="name">account.effect.remittance.form</field>
        <field name="model">account.effect.remittance</field>
        <field name="arch" type="xml">
            <form string="Remesa">
                <header>
                    <button name="action_generate" type="object" string="Generar" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_send" type="object" string="Enviar al banco" invisible="state != 'generated'"/>
                    <button name="action_present" type="object" string="Presentar" invisible="state != 'sent'"/>
                    <button name="action_paid" type="object" string="Marcar cobrada" invisible="state not in ('presented','partial')"/>
                    <button name="action_return" type="object" string="Marcar devuelta" invisible="state in ('draft','cancelled','paid')"/>
                    <button name="action_cancel" type="object" string="Anular" class="btn-secondary" invisible="state in ('paid','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,sent,presented,paid"/>
                </header>
                <sheet>
                    <group col="2">
                        <group><field name="name" readonly="1"/><field name="date"/><field name="due_date"/></group>
                        <group><field name="journal_id"/><field name="effect_count" readonly="1"/><field name="amount_total" readonly="1"/></group>
                    </group>
                    <notebook>
                        <page string="Efectos">
                            <field name="effect_ids" domain="[('remittance_id','=',False),('payment_state','in',['pending','grouped'])]" context="{'default_effect_type':'effect'}">
                                <list editable="bottom">
                                    <field name="effect_number" readonly="1"/><field name="partner_id"/><field name="due_date"/><field name="amount"/><field name="payment_method"/><field name="payment_state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas"><field name="notes"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_effect_remittances" model="ir.actions.act_window">
        <field name="name">Remesas</field>
        <field name="res_model">account.effect.remittance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
