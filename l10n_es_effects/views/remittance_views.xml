<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_effect_remittance_list" model="ir.ui.view">
        <field name="name">account.effect.remittance.list</field>
        <field name="model">account.effect.remittance</field>
        <field name="arch" type="xml">
            <list string="Remesas">
                <field name="name"/>
                <field name="date"/>
                <field name="company_type"/>
                <field name="effect_count"/>
                <field name="amount_total"/>
                <field name="amount_paid"/>
                <field name="amount_pending"/>
                <field name="currency_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_account_effect_remittance_form" model="ir.ui.view">
        <field name="name">account.effect.remittance.form</field>
        <field name="model">account.effect.remittance</field>
        <field name="arch" type="xml">
            <form string="Remesa">
                <header>
                    <button name="action_mark_sent" type="object" string="Marcar enviada"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_saldar_entero" type="object" string="Saldar (entero)"
                            class="btn-primary" invisible="state in ('draft', 'paid', 'cancelled')"/>
                    <button name="action_saldar_parcial" type="object" string="Saldado parcial"
                            invisible="state in ('draft', 'paid', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,partial,paid,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date"/>
                            <field name="company_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id" readonly="1"/>
                            <field name="effect_count" readonly="1"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="amount_paid" readonly="1"/>
                            <field name="amount_pending" readonly="1"/>
                        </group>
                    </group>
                    <field name="effect_ids">
                        <list create="false" delete="false">
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="reference"/>
                            <field name="due_date"/>
                            <field name="amount"/>
                            <field name="amount_pending"/>
                            <field name="payment_state"/>
                            <field name="state"/>
                        </list>
                    </field>
                    <separator string="Notas"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_effect_remittance" model="ir.actions.act_window">
        <field name="name">Remesas</field>
        <field name="res_model">account.effect.remittance</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_effect_remittance_list"/>
    </record>
</odoo>
