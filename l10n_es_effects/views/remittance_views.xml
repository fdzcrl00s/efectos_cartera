<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_effect_remittance_list" model="ir.ui.view">
        <field name="name">account.effect.remittance.list</field>
        <field name="model">account.effect.remittance</field>
        <field name="arch" type="xml">
            <list string="Remesas" default_order="date desc, id desc">
                <field name="cartera_number" string="Nº Cartera"/>
                <field name="name"/>
                <field name="date"/>
                <field name="company_type"/>
                <field name="effect_count"/>
                <field name="amount_total"/>
                <field name="amount_paid"/>
                <field name="amount_pending"/>
                <field name="currency_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_account_effect_remittance_form" model="ir.ui.view">
        <field name="name">account.effect.remittance.form</field>
        <field name="model">account.effect.remittance</field>
        <field name="arch" type="xml">
            <form string="Remesa">
                <header>
                    <button name="action_add_pending_effects" type="object" string="Añadir efectos" class="oe_highlight"/>
                    <button name="action_mark_sent" type="object" string="Marcar enviada"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_saldar_entero" type="object" string="Saldar (entero)"
                            class="btn-primary" invisible="state in ('draft', 'paid', 'cancelled')"/>
                    <button name="action_saldar_parcial" type="object" string="Saldado parcial"
                            invisible="state in ('draft', 'paid', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="cartera_number"/>
                            <field name="company_type"/>
                            <field name="company_id"/>
                            <field name="bank_journal_id"/>
                            <field name="partner_bank_id"/>
                            <field name="amount_total"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                            <field name="reference" string="Circular / Concepto"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Efectos agrupados">
                            <field name="effect_ids">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="due_date"/>
                                    <field name="display_label" string="Nombre"/>
                                    <field name="partner_id"/>
                                    <field name="amount"/>
                                    <field name="amount_pending"/>
                                    <field name="payment_state"/>
                                    <field name="state"/>
                                </list>
                            </field>
                            <div class="o_row mt-2">
                                <button name="action_ungroup_selected" type="object"
                                        string="Desagrupación Masiva"/>
                                <button name="action_update_changes" type="object"
                                        string="Actualizar cambios"/>
                            </div>
                        </page>
                        <page string="Histórico Pagos">
                            <field name="effect_ids">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="payment_state"/>
                                    <field name="amount_pending"/>
                                </list>
                            </field>
                        </page>
                        <page string="Histórico Situaciones">
                            <field name="effect_ids">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_account_effect_remittance" model="ir.actions.act_window">
        <field name="name">Remesas</field>
        <field name="res_model">account.effect.remittance</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_effect_remittance_list"/>
    </record>
</odoo>