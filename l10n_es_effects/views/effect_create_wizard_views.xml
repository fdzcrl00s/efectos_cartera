<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_effect_create_wizard" model="ir.ui.view">
        <field name="name">account.effect.create.wizard.form</field>
        <field name="model">account.effect.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear elemento de cartera">
                <group>
                    <field name="effect_type" widget="radio" options="{'horizontal': true}"/>
                </group>
                <notebook>
                    <page string="Efecto" invisible="effect_type != 'effect'">
                        <group>
                            <group>
                                <field name="company_type"/>
                                <field name="partner_id" string="Cliente / Proveedor"/>
                                <field name="currency_id"/>
                                <field name="payment_direction" readonly="1"/>
                                <field name="move_id" domain="[('company_id', '=', company_id), ('state', '=', 'posted'), ('move_type', 'in', ('out_invoice', 'in_invoice'))]"/>
                            </group>
                            <group>
                                <field name="due_date"/>
                                <field name="amount"/>
                                <field name="bank_journal_id"/>
                                <field name="partner_bank_id"/>
                                <field name="reference" string="Circular / Concepto"/>
                            </group>
                        </group>
                    </page>
                    <page string="Agrupación" invisible="effect_type != 'group'">
                        <group>
                            <group>
                                <field name="company_type"/>
                                <field name="currency_id"/>
                            </group>
                            <group>
                                <field name="due_date"/>
                                <field name="bank_journal_id"/>
                                <field name="partner_bank_id"/>
                                <field name="reference" string="Circular / Concepto"/>
                                <field name="notes"/>
                            </group>
                        </group>
                        <div class="alert alert-info">
                            Primero se crea la agrupación vacía. Después podrás añadir los efectos pendientes desde su formulario.
                        </div>
                    </page>
                    <page string="Remesa" invisible="effect_type != 'remittance'">
                        <group>
                            <group>
                                <field name="company_id" readonly="1"/>
                                <field name="currency_id"/>
                                <field name="payment_direction" readonly="1"/>
                            </group>
                            <group>
                                <field name="due_date"/>
                                <field name="bank_journal_id"/>
                                <field name="partner_bank_id"/>
                                <field name="reference" string="Circular / Concepto"/>
                                <field name="notes"/>
                            </group>
                        </group>
                        <div class="alert alert-info">
                            Primero se crea la remesa vacía. Después podrás añadir los efectos pendientes desde su formulario.
                        </div>
                    </page>
                </notebook>
                <footer>
                    <button name="action_create" type="object" string="Crear" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
