<odoo>
    <record id="view_account_effect_list" model="ir.ui.view">
        <field name="name">account.effect.list</field>
        <field name="model">account.effect</field>
        <field name="arch" type="xml">
            <list string="Efectos de Cartera" create="true" multi_edit="1">
                <header>
                    <button name="action_group_selected" type="object" string="Agrupar efectos" class="btn-secondary"/>
                </header>
                <field name="effect_number" string="Nº Efecto"/>
                <field name="portfolio_number" string="Nº Cartera"/>
                <field name="reference" string="Nº Referencia"/>
                <field name="due_date" string="Vencimiento"/>
                <field name="name" string="Nombre"/>
                <field name="partner_id" string="Cliente/Proveedor"/>
                <field name="effect_type" string="Tipo de Efecto"/>
                <field name="destination_account_id" string="Cuenta"/>
                <field name="payment_method" string="Documento de Pago"/>
                <field name="payment_state" string="Estado del Pago"/>
                <field name="situation" string="Situación"/>
                <field name="move_id" string="Nº doc. Contable"/>
                <field name="signed_amount" string="Total" sum="Total"/>
                <field name="pending_amount" string="Pendiente" sum="Pendiente"/>
            </list>
        </field>
    </record>

    <record id="view_account_effect_form" model="ir.ui.view">
        <field name="name">account.effect.form</field>
        <field name="model">account.effect</field>
        <field name="arch" type="xml">
            <form string="Efecto de Cartera">
                <header>
                    <button name="action_register_payment" type="object" string="Saldar" class="btn-primary" invisible="payment_state == 'paid' or not move_id"/>
                    <button name="action_mark_returned" type="object" string="Convertir en Moroso" class="btn-danger" invisible="payment_state in ('paid','cancelled','uncollectible')"/>
                    <button name="action_mark_uncollectible" type="object" string="Convertir en Incobrable" class="btn-danger" invisible="payment_state in ('paid','cancelled','uncollectible')"/>
                    <button name="action_set_in_portfolio" type="object" string="Pasar a Cartera" invisible="situation == 'in_portfolio' or payment_state == 'paid'"/>
                    <field name="situation" widget="statusbar" statusbar_visible="pending,in_portfolio,remitted,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_set_in_portfolio" type="object" class="oe_stat_button" icon="fa-briefcase" invisible="situation == 'in_portfolio'">
                            <div class="o_stat_info"><span class="o_stat_text">Cartera</span></div>
                        </button>
                    </div>
                    <group col="2">
                        <group>
                            <field name="effect_number" readonly="1"/>
                            <field name="effect_type"/>
                            <field name="company_type"/>
                            <field name="company_id"/>
                            <field name="partner_id"/>
                            <field name="bank_account_id"/>
                            <field name="destination_account_id"/>
                            <field name="payment_type"/>
                            <field name="amount"/>
                            <field name="signed_amount" readonly="1"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                            <field name="reference"/>
                            <field name="move_id"/>
                            <field name="move_line_id"/>
                            <field name="journal_id"/>
                            <field name="payment_method"/>
                            <field name="payment_state"/>
                            <field name="situation"/>
                            <field name="pending_amount" readonly="1"/>
                            <field name="remittance_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Efectos Agrupados" invisible="not child_effect_ids">
                            <field name="child_effect_ids" readonly="1">
                                <list>
                                    <field name="effect_number"/>
                                    <field name="portfolio_number"/>
                                    <field name="due_date"/>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="amount"/>
                                    <field name="pending_amount"/>
                                    <field name="payment_state"/>
                                    <field name="journal_id"/>
                                    <field name="payment_method"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pago">
                            <field name="payment_id" readonly="1"/>
                        </page>
                        <page string="Notas">
                            <field name="notes" placeholder="Notas y observaciones de cartera..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_effect_search" model="ir.ui.view">
        <field name="name">account.effect.search</field>
        <field name="model">account.effect</field>
        <field name="arch" type="xml">
            <search string="Buscar efectos">
                <field name="effect_number"/><field name="portfolio_number"/><field name="reference"/><field name="partner_id"/><field name="move_id"/>
                <filter name="pending" string="Pendientes" domain="[('payment_state','=','pending')]"/>
                <filter name="portfolio" string="En cartera" domain="[('situation','=','in_portfolio')]"/>
                <filter name="grouped" string="Agrupados" domain="[('payment_state','=','grouped')]"/>
                <filter name="remitted" string="Remesados" domain="[('payment_state','=','remitted')]"/>
                <filter name="paid" string="Saldados" domain="[('payment_state','=','paid')]"/>
                <filter name="returned" string="Devueltos" domain="[('payment_state','=','returned')]"/>
                <filter name="uncollectible" string="Incobrables" domain="[('payment_state','=','uncollectible')]"/>
                <separator/>
                <filter name="customer" string="Clientes" domain="[('company_type','=','customer')]"/>
                <filter name="supplier" string="Proveedores" domain="[('company_type','=','supplier')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Cliente/Proveedor" context="{'group_by':'partner_id'}"/>
                    <filter string="Vencimiento" context="{'group_by':'due_date'}"/>
                    <filter string="Estado" context="{'group_by':'payment_state'}"/>
                    <filter string="Tipo" context="{'group_by':'effect_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_customer_effects" model="ir.actions.act_window">
        <field name="name">Efectos de Clientes</field>
        <field name="res_model">account.effect</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_effect_list"/>
        <field name="search_view_id" ref="view_account_effect_search"/>
        <field name="domain">[('company_type','=','customer')]</field>
        <field name="context">{'default_company_type':'customer','default_payment_type':'receive'}</field>
    </record>
    <record id="action_supplier_effects" model="ir.actions.act_window">
        <field name="name">Efectos de Proveedores</field>
        <field name="res_model">account.effect</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_effect_list"/>
        <field name="search_view_id" ref="view_account_effect_search"/>
        <field name="domain">[('company_type','=','supplier')]</field>
        <field name="context">{'default_company_type':'supplier','default_payment_type':'send'}</field>
    </record>
</odoo>
