<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_effect_list" model="ir.ui.view">
        <field name="name">account.effect.list</field>
        <field name="model">account.effect</field>
        <field name="arch" type="xml">
            <list string="Efectos" create="false" default_order="due_date desc, id desc"
                  decoration-danger="state in ('pending', 'grouped', 'remitted') and (is_container or state == 'pending')" decoration-info="not is_container and state in ('grouped', 'remitted')" decoration-success="state == 'paid'">
                <header>
                    <button name="action_create_from_menu" type="object" string="Crear" class="btn-primary" display="always" invisible="context.get('remittance_id')"/>
                    <button name="action_group_selected" type="object" string="Agrupar" invisible="context.get('remittance_id')"/>
                    <button name="action_create_remittance_selected" type="object" string="Crear remesa" invisible="context.get('remittance_id')"/>
                    <button name="action_add_selected_to_remittance" type="object" string="Añadir seleccionados" class="btn-primary" invisible="not context.get('remittance_id')"/>
                </header>
                <field name="is_container" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="name" string="Nº Efecto"/>
                <field name="display_reference" string="Referencia"/>
                <field name="cartera_number" string="Nº Cartera"/>
                <field name="due_date" string="Vencimiento"/>
                <field name="display_label" string="Nombre"/>
                <field name="partner_id" string="Cliente"/>
                <field name="effect_type" string="Tipo de Efecto"/>
                <field name="display_payment_state" string="Estado del pago"/>
                <field name="display_situation" string="Situación"/>
                <field name="amount" string="Total" sum="Total"/>
                <field name="amount_pending" string="Total pendiente" sum="Total pendiente"/>
            </list>
        </field>
    </record>

    <record id="view_account_effect_form" model="ir.ui.view">
        <field name="name">account.effect.form</field>
        <field name="model">account.effect</field>
        <field name="arch" type="xml">
            <form string="Cartera">
                <header>
                    <button name="action_add_pending_effects" type="object" string="Añadir efectos" class="oe_highlight"
                            invisible="not container_remittance_id or container_remittance_id.state != 'draft'"/>
                    <button name="action_saldar_entero" type="object" string="Saldar (entero)" class="btn-primary"
                            invisible="not container_remittance_id or amount_pending == 0"/>
                    <button name="action_saldar_parcial" type="object" string="Saldar parcialmente"
                            invisible="not container_remittance_id or amount_pending == 0"/>
                    <button name="action_saldar" type="object" string="Saldar" class="btn-primary"
                            invisible="is_container or state in ('paid', 'returned', 'uncollectible') or not move_line_id"/>
                    <button name="action_anular_saldado" type="object" string="Anular saldado" invisible="not payment_id"/>
                    <button name="action_devolver_efectos" type="object" string="Devolver efectos"
                            invisible="not container_remittance_id or not payment_id"/>
                    <button name="action_devolver" type="object" string="Devolver" invisible="state != 'paid' or is_container"/>
                    <field name="situation_state" widget="statusbar"
                           statusbar_visible="pending,paid,returned" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_invoice" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" invisible="not move_id">
                            <span class="o_stat_text">Factura</span>
                        </button>
                        <button name="action_open_payment" type="object" class="oe_stat_button"
                                icon="fa-money" invisible="not payment_id">
                            <span class="o_stat_text">Pago</span>
                        </button>
                        <button name="action_open_accounting_entries" type="object" class="oe_stat_button"
                                icon="fa-book" invisible="not payment_move_id and not adjustment_move_id">
                            <span class="o_stat_text">Asientos</span>
                        </button>
                    </div>
                    <h1><field name="display_label" readonly="1"/></h1>
                    <field name="is_container" invisible="1"/>
                    <field name="is_portfolio_effect" invisible="1"/>
                    <field name="payment_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="name" string="Nº Efecto" readonly="1"/>
                            <field name="cartera_number" string="Nº Cartera" readonly="1"/>
                            <field name="effect_type"/>
                            <field name="company_type"/>
                            <field name="partner_id"/>
                            <field name="bank_journal_id"/>
                            <field name="partner_bank_id"/>
                            <field name="payment_direction"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="due_date" string="Fecha de vencimiento"/>
                            <field name="reference" string="Circular / Concepto"/>
                            <field name="state" string="Situación" readonly="1"/>
                            <field name="situation_ref" string="Pertenece a" widget="reference"
                                   readonly="1" invisible="not situation_ref"/>
                            <field name="amount" string="Total" readonly="1"/>
                            <field name="amount_pending" string="Total pendiente" readonly="1"/>
                            <field name="invoice_reference" string="Factura" readonly="1"
                                   invisible="not invoice_reference"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Efectos asociados">
                            <field name="portfolio_effect_ids" nolabel="1">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="due_date"/>
                                    <field name="reference" string="Circular / Concepto"/>
                                    <field name="partner_id" string="Empresa"/>
                                    <field name="amount_pending" string="Cantidad a pagar"/>
                                    <field name="payment_state" string="Estado del pago"/>
                                    <field name="bank_journal_id" string="Diario de pago"/>
                                    <button name="action_ungroup_selected" type="object" string="Quitar" class="btn-link" invisible="state == 'paid'"/>
                                </list>
                            </field>
                            <div class="o_row mt-2">
                                <button name="action_ungroup_selected" type="object"
                                        string="Desagrupación Masiva"
                                        invisible="not group_id and not remittance_id"/>
                                <button name="action_refresh_payment_state" type="object"
                                        string="Actualizar cambios"/>
                            </div>
                        </page>
                        <page string="Histórico Pagos">
                            <field name="payment_history_ids" nolabel="1">
                                <list create="false" delete="false">
                                    <field name="date"/>
                                    <field name="payment_id"/>
                                    <field name="journal_id"/>
                                    <field name="amount"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Histórico Situaciones">
                            <field name="situation_history_ids" nolabel="1">
                                <list create="false" delete="false">
                                    <field name="date"/>
                                    <field name="state"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_effect_search" model="ir.ui.view">
        <field name="name">account.effect.search</field>
        <field name="model">account.effect</field>
        <field name="arch" type="xml">
            <search string="Buscar efectos">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="display_reference"/>
                <field name="due_date"/>
                <field name="state"/>
                <field name="company_type"/>
                <field name="effect_type"/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'pending')]"/>
                <filter name="paid" string="Saldados" domain="[('state', '=', 'paid')]"/>
                <filter name="group_due_date_month" string="Por mes" context="{'group_by': 'due_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_account_effect_customer" model="ir.actions.act_window">
        <field name="name">Efectos de clientes</field>
        <field name="res_model">account.effect</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_effect_list"/>
        <field name="domain">[('company_type', '=', 'customer'), ('is_portfolio_effect', '=', False)]</field>
        <field name="context">{'default_company_type': 'customer', 'default_effect_type': 'effect'}</field>
    </record>
    <record id="action_account_effect_supplier" model="ir.actions.act_window">
        <field name="name">Efectos de proveedores</field>
        <field name="res_model">account.effect</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_effect_list"/>
        <field name="domain">[('company_type', '=', 'supplier'), ('is_portfolio_effect', '=', False)]</field>
        <field name="context">{'default_company_type': 'supplier', 'default_effect_type': 'effect'}</field>
    </record>
</odoo>