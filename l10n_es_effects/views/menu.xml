<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Las acciones de menú sincronizan los registros virtuales de agrupaciones/remesas
         para que también aparezcan en el listado único de efectos. -->
    <record id="action_account_effect_customer_sync" model="ir.actions.server">
        <field name="name">Efectos de clientes</field>
        <field name="model_id" ref="model_account_effect"/>
        <field name="state">code</field>
        <field name="code">action = env['account.effect'].action_open_effects('customer')</field>
    </record>
    <record id="action_account_effect_supplier_sync" model="ir.actions.server">
        <field name="name">Efectos de proveedores</field>
        <field name="model_id" ref="model_account_effect"/>
        <field name="state">code</field>
        <field name="code">action = env['account.effect'].action_open_effects('supplier')</field>
    </record>

    <menuitem id="menu_effects_root" name="Cartera" parent="account.menu_finance" sequence="4"/>
    <record id="account.menu_finance_entries" model="ir.ui.menu">
        <field name="sequence">5</field>
    </record>
    <menuitem id="menu_effects_customer" name="Efectos de clientes"
              parent="menu_effects_root" action="action_account_effect_customer_sync" sequence="10"/>
    <menuitem id="menu_effects_supplier" name="Efectos de proveedores"
              parent="menu_effects_root" action="action_account_effect_supplier_sync" sequence="20"/>

    <record id="action_account_effect_employee_tax" model="ir.actions.server">
        <field name="name">Efectos de empleados y tributos</field>
        <field name="model_id" ref="model_account_effect"/>
        <field name="state">code</field>
        <field name="code">action = env['account.effect'].action_open_manual_effects()</field>
    </record>
    <menuitem id="menu_effects_employee_tax" name="Efectos de empleados y tributos"
              parent="menu_effects_root" action="action_account_effect_employee_tax" sequence="30"/>
    <menuitem id="menu_effects_administration" name="Administración"
              parent="account.menu_finance_configuration" sequence="75"
              groups="account.group_account_manager"/>
    <menuitem id="menu_effects_payment_documents" name="Documentos de pago"
              parent="menu_effects_administration" action="action_account_effect_payment_document"
              sequence="10" groups="account.group_account_manager"/>
</odoo>
