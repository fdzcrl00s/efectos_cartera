<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_effect_group_list" model="ir.ui.view">
        <field name="name">account.effect.group.list</field>
        <field name="model">account.effect.group</field>
        <field name="arch" type="xml">
            <list string="Agrupaciones">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="company_type"/>
                <field name="effect_count"/>
                <field name="amount_total"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="remittance_id"/>
            </list>
        </field>
    </record>

    <record id="view_account_effect_group_form" model="ir.ui.view">
        <field name="name">account.effect.group.form</field>
        <field name="model">account.effect.group</field>
        <field name="arch" type="xml">
            <form string="Agrupación">
                <header>
                    <button name="action_create_remittance" type="object" string="Crear remesa"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,remitted,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_type" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="effect_count" readonly="1"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="remittance_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="effect_ids">
                        <list create="false" delete="false">
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="reference"/>
                            <field name="due_date"/>
                            <field name="amount"/>
                            <field name="state"/>
                        </list>
                    </field>
                    <separator string="Notas"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_effect_group" model="ir.actions.act_window">
        <field name="name">Agrupaciones</field>
        <field name="res_model">account.effect.group</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_effect_group_list"/>
    </record>
</odoo>
