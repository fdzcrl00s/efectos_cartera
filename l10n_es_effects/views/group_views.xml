<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_effect_group_list" model="ir.ui.view">
        <field name="name">account.effect.group.list</field>
        <field name="model">account.effect.group</field>
        <field name="arch" type="xml">
            <list string="Agrupaciones" default_order="date desc, id desc" decoration-danger="state == 'draft'" decoration-info="state != 'draft'">
                <button name="action_open_effect" type="object" string="Nº Cartera" class="oe_link"/>
                <field name="name"/>
                <field name="date" string="Fecha de asiento"/>
                <field name="partner_id"/>
                <field name="company_type"/>
                <field name="effect_count"/>
                <field name="amount_total"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="paid_date"/>
            </list>
        </field>
    </record>
    <record id="view_account_effect_group_form" model="ir.ui.view">
        <field name="name">account.effect.group.form</field>
        <field name="model">account.effect.group</field>
        <field name="arch" type="xml">
            <form string="Agrupación">
                <field name="has_active_payments" invisible="1"/>
                <header>
                    <button name="action_add_pending_effects" type="object" string="Añadir efectos" class="oe_highlight" invisible="state != 'draft' or has_active_payments"/>
                    <button name="action_saldar" type="object" string="Saldar (entero)" class="btn-primary" invisible="state == 'paid' or effect_count == 0 or amount_pending == 0"/>
                    <button name="action_create_remittance" type="object" string="Crear remesa"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><span>Agrupación nº </span><field name="cartera_number" readonly="1" nolabel="1"/></h1>
                    <group>
                        <group>
                            <field name="cartera_number" string="Nº Cartera" readonly="1"/>
                            <field name="company_type"/>
                            <field name="partner_id"/>
                            <field name="bank_journal_id"/>
                            <field name="partner_bank_id"/>
                            <field name="payment_direction"/>
                            <field name="amount_total"/>
                        </group>
                        <group>
                            <field name="date" string="Fecha de asiento"/>
                            <field name="due_date"/>
                            <field name="reference" string="Circular / Concepto"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Efectos agrupados">
                            <field name="effect_ids">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="due_date"/>
                                    <field name="display_label" string="Nombre"/>
                                    <field name="partner_id"/>
                                    <field name="amount"/>
                                    <field name="amount_pending"/>
                                    <field name="display_payment_state"/>
                                    <button name="action_ungroup_selected" type="object" string="Quitar" class="btn-link" invisible="parent.state != 'draft' or parent.has_active_payments or state == 'paid'"/>
                                </list>
                            </field>
                            <div class="o_row mt-2">
                                <button name="action_ungroup_selected" type="object" string="Desagrupación Masiva" invisible="state != 'draft' or has_active_payments"/>
                                <button name="action_update_changes" type="object" string="Actualizar cambios"/>
                            </div>
                        </page>
                        <page string="Efectos de la misma Cartera">
                            <field name="portfolio_effect_ids">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="reference" string="Referencia"/>
                                    <field name="due_date" string="Fecha"/>
                                    <field name="amount"/>
                                    <field name="amount_pending"/>
                                    <field name="display_payment_state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Histórico Pagos">
                            <field name="payment_history_ids">
                                <list create="false" delete="false">
                                    <field name="id"/>
                                    <field name="reference"/>
                                    <field name="move_id" string="Asiento"/>
                                    <field name="date"/>
                                    <field name="effect_ids" string="Agrupar Efectos"/>
                                    <field name="amount" string="Total"/>
                                    <field name="type" string="Tipo"/>
                                </list>
                            </field>
                        </page>
                        <page string="Histórico Situaciones">
                            <field name="effect_ids">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="situation_state" string="Situación"/>
                                    <field name="paid_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_account_effect_group" model="ir.actions.act_window">
        <field name="name">Agrupaciones</field>
        <field name="res_model">account.effect.group</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_effect_group_list"/>
    </record>
</odoo>