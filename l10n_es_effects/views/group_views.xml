<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_effect_group_list" model="ir.ui.view">
        <field name="name">account.effect.group.list</field>
        <field name="model">account.effect.group</field>
        <field name="arch" type="xml">
            <list string="Agrupaciones de efectos">
                <field name="name"/>
                <field name="date"/>
                <field name="company_type"/>
                <field name="partner_id"/>
                <field name="effect_count"/>
                <field name="amount_total" sum="Total"/>
                <field name="state"/>
                <field name="remittance_id"/>
            </list>
        </field>
    </record>

    <record id="view_account_effect_group_form" model="ir.ui.view">
        <field name="name">account.effect.group.form</field>
        <field name="model">account.effect.group</field>
        <field name="arch" type="xml">
            <form string="Agrupación de efectos">
                <header>
                    <button name="action_create_remittance" type="object" string="Crear remesa" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,remitted,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date"/>
                            <field name="company_type"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="effect_count" readonly="1"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="remittance_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="effect_ids" readonly="state != 'draft'">
                        <list>
                            <field name="name"/>
                            <field name="move_id"/>
                            <field name="partner_id"/>
                            <field name="due_date"/>
                            <field name="amount"/>
                            <field name="state"/>
                        </list>
                    </field>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_effect_group_search" model="ir.ui.view">
        <field name="name">account.effect.group.search</field>
        <field name="model">account.effect.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="draft" string="Borrador" domain="[('state','=','draft')]"/>
                <filter name="remitted" string="Remesadas" domain="[('state','=','remitted')]"/>
            </search>
        </field>
    </record>

    <record id="action_effect_groups" model="ir.actions.act_window">
        <field name="name">Agrupaciones</field>
        <field name="res_model">account.effect.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
