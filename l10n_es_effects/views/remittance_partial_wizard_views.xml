<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_effect_remittance_partial_wizard" model="ir.ui.view">
        <field name="name">account.effect.remittance.partial.wizard.form</field>
        <field name="model">account.effect.remittance.partial.wizard</field>
        <field name="arch" type="xml">
            <form string="Saldado parcial">
                <sheet>
                    <group>
                        <field name="remittance_id"/>
                    </group>
                    <field name="effect_ids">
                        <list create="false" delete="false">
                            <field name="name"/>
                            <field name="reference"/>
                            <field name="due_date"/>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="amount_pending"/>
                            <field name="payment_state"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_saldar" type="object" string="Saldar seleccionados" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
