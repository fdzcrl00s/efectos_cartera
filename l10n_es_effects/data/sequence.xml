<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_account_effect" model="ir.sequence">
        <field name="name">Efectos de cartera</field>
        <field name="code">account.effect</field>
        <field name="prefix">EF-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_account_effect_group" model="ir.sequence">
        <field name="name">Agrupaciones de efectos</field>
        <field name="code">account.effect.group</field>
        <field name="prefix">AGR-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_account_effect_remittance" model="ir.sequence">
        <field name="name">Remesas de efectos</field>
        <field name="code">account.effect.remittance</field>
        <field name="prefix">REM-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
